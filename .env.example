# ---------------------------------------------------------------
# Aura configuration. Copy to .env and edit. Everything is optional:
# with no .env the app runs fully offline on rules + sample data.
# ---------------------------------------------------------------

# Language model used ONLY for (a) understanding messages the rules can't,
# (b) optional natural rewording of replies, (c) translating knowledge answers.
#   custom = no LLM (default, deterministic)   ollama = local Ollama   api = OpenRouter/Groq
LLM_PROVIDER=custom
LLM_API_PROVIDER=openrouter        # openrouter | groq
LLM_API_KEY=your_api_key_here      # required only when LLM_PROVIDER=api
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
OLLAMA_MODEL=llama3.2:3b           # when LLM_PROVIDER=ollama
API_TIMEOUT_SECONDS=4.0
LLM_REPHRASE=true                  # reword replies with the LLM (facts are checked; falls back to templates)
REPHRASE_TIMEOUT_SECONDS=3.0

# Optional multilingual intent model (needs transformers + torch)
USE_MBERT=false
MBERT_MODEL=bert-base-multilingual-cased
MBERT_CONFIDENCE_THRESHOLD=0.70

# Server
PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Developer only: include intent/confidence/source/timings in /chat responses.
# Never enable for customers; these always go to the server log + /admin anyway.
EXPOSE_DEBUG=false
